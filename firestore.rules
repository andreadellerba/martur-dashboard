rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{uid} {
      // Ogni utente autenticato puo' leggere gli username (servono per le menzioni in chat).
      allow read: if isSignedIn();
      // Solo un amministratore puo' creare/modificare/eliminare utenti e ruoli.
      allow write: if isSignedIn() && myRole() == 'configAdmin';
    }

    match /messages/{msgId} {
      allow read: if isSignedIn();
      // Chiunque sia autenticato puo' inviare un messaggio a proprio nome.
      allow create: if isSignedIn()
        && request.resource.data.username is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600;
      // I messaggi non si modificano; solo un amministratore puo' eliminarli.
      allow update: if false;
      allow delete: if isSignedIn() && myRole() == 'configAdmin';
    }

    match /entries/{date} {
      // Dati aziendali: si leggono solo da autenticati. L'accesso anonimo e'
      // disabilitato nel progetto, quindi serve un utente vero.
      allow read: if isSignedIn();
      // Solo utenti autenticati con ruolo admin/configAdmin possono inserire o modificare dati.
      allow write: if isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
    }

    match /stoppages/{id} {
      // Microfermate: le registra e le corregge chiunque sia autenticato.
      allow read, write: if isSignedIn();
    }

    match /config/{id} {
      // Parametri condivisi (minuti pianificati e target Kit per turno):
      // valgono per tutti, quindi stanno qui e non sul singolo dispositivo.
      allow read, write: if isSignedIn();
    }

    match /tasks/{id} {
      // Riepilogo attivita': la vede chi e' autenticato, la modifica solo un admin.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
    }

    match /anomalies/{id} {
      // Report anomalie (schede anomalia): come le attivita'.
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
      // Il QR in linea permette a chiunque, anche senza accesso, di aprire una
      // scheda nuova col numero successivo del contatore: solo i campi del
      // modulo, testi di lunghezza limitata e ora del server. Leggere o
      // toccare le altre schede resta vietato.
      allow create: if isAdmin() || isQrReport(id);
    }

    match /anomalySettings/{doc} {
      // "main": nomi delle colonne e dati documento predefiniti, letti anche
      // dal modulo QR. "counter": ultimo N. scheda usato.
      allow read: if true;
      allow write: if isAdmin();
      // Dal QR il contatore puo' solo salire di uno, insieme alla scheda nuova
      // che prende quel numero.
      allow update: if doc == 'counter'
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1
        && existsAfter(/databases/$(database)/documents/anomalies/$('n-' + string(request.resource.data.last)));
    }

    function optText(d, key, max) {
      return !d.keys().hasAny([key]) || (d[key] is string && d[key].size() <= max);
    }
    function optDate(d, key) {
      return !d.keys().hasAny([key]) || d[key] == null || (d[key] is string && d[key].size() == 10);
    }

    function isQrReport(id) {
      let d = request.resource.data;
      let counter = /databases/$(database)/documents/anomalySettings/counter;
      return d.keys().hasOnly(['number', 'reporter', 'machine', 'openedAt', 'description', 'action',
          'dueAt', 'owner', 'ownerRole', 'closedAt', 'status', 'source', 'createdAt',
          'docIssued', 'docRevised', 'docRevision', 'docClass', 'docNumber'])
        && d.source == 'qr'
        && d.createdAt == request.time
        && d.number is int
        && id == 'n-' + string(d.number)
        && d.number == get(counter).data.last + 1
        && getAfter(counter).data.last == d.number
        && d.reporter is string && d.reporter.size() > 0 && d.reporter.size() <= 80
        && d.description is string && d.description.size() > 0 && d.description.size() <= 800
        && d.openedAt is string && d.openedAt.size() == 10
        && d.status in ['open', 'doing', 'closed']
        && (!d.keys().hasAny(['ownerRole']) || d.ownerRole == null || d.ownerRole in ['operator', 'maintainer'])
        && optText(d, 'machine', 40) && optText(d, 'action', 800) && optText(d, 'owner', 80)
        && optDate(d, 'dueAt') && optDate(d, 'closedAt')
        && optText(d, 'docIssued', 40) && optText(d, 'docRevised', 40) && optText(d, 'docRevision', 40)
        && optText(d, 'docClass', 40) && optText(d, 'docNumber', 40);
    }

    match /auditLog/{id} {
      // Ogni utente autenticato puo' registrare un proprio evento (login/modifica);
      // il registro si legge/elimina solo con ruolo configAdmin.
      // la riga deve portare l'uid di chi la scrive: nessuno puo' registrare
      // un'azione a nome di un altro utente
      allow create: if isSignedIn()
        && request.resource.data.username is string
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isSignedIn() && myRole() == 'configAdmin';
      allow update: if false;
    }
  }
}
