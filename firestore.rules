rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{uid} {
      // Ogni utente autenticato puo' leggere gli username (servono per le menzioni in chat).
      allow read: if isSignedIn();
      // Solo un amministratore puo' creare/modificare/eliminare utenti e ruoli.
      allow write: if isSignedIn() && myRole() == 'configAdmin';
    }

    match /messages/{msgId} {
      allow read: if isSignedIn();
      // Chiunque sia autenticato puo' inviare un messaggio a proprio nome.
      allow create: if isSignedIn()
        && request.resource.data.username is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600;
      // I messaggi non si modificano; solo un amministratore puo' eliminarli.
      allow update: if false;
      allow delete: if isSignedIn() && myRole() == 'configAdmin';
    }

    match /entries/{date} {
      // Dati aziendali: si leggono solo da autenticati. L'accesso anonimo e'
      // disabilitato nel progetto, quindi serve un utente vero.
      allow read: if isSignedIn();
      // Solo utenti autenticati con ruolo admin/configAdmin possono inserire o modificare dati.
      allow write: if isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
    }

    match /sections/{date} {
      // Numeri delle pagine ABARTH - DMC e Q GATE, un documento per data:
      // li legge e li inserisce chiunque abbia l'accesso.
      allow read, write: if isSignedIn();
    }

    match /stoppages/{id} {
      // Microfermate: le registra e le corregge chiunque sia autenticato.
      allow read, write: if isSignedIn();
    }

    match /config/{id} {
      // Parametri condivisi (minuti pianificati e target Kit per turno):
      // valgono per tutti, quindi stanno qui e non sul singolo dispositivo.
      allow read, write: if isSignedIn();
    }

    match /tasks/{id} {
      // Riepilogo attivita': la vede chi e' autenticato, la modifica solo un
      // admin. Unica eccezione: spostare una card fra le colonne (categoria,
      // stato e data di chiusura) lo puo' fare chiunque abbia l'accesso.
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
      allow update: if isSignedIn() && ((myRole() == 'admin' || myRole() == 'configAdmin')
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['category', 'status', 'closedAt', 'updatedAt', 'updatedBy']));
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'configAdmin');
    }

    match /anomalies/{id} {
      // Schede anomalia: le legge chi ha l'accesso, le modifica e le elimina
      // solo un admin. Una scheda nuova puo' aprirla chiunque abbia l'accesso
      // e anche chi arriva dal QR senza accesso: in quel caso valgono solo i
      // campi del modulo, con testi di lunghezza limitata e ora del server.
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
      allow create: if (isSignedIn() && isValidAnomaly()) || isQrReport();
    }

    match /anomalySettings/{doc} {
      // "main": nomi di titolo e colonne, letti anche dal modulo QR.
      allow read: if true;
      allow write: if isAdmin();
    }

    function optText(d, key, max) {
      return !d.keys().hasAny([key]) || (d[key] is string && d[key].size() <= max);
    }
    function optDate(d, key) {
      return !d.keys().hasAny([key]) || d[key] == null || (d[key] is string && d[key].size() == 10);
    }
    function anomalyFieldsOk(d) {
      return d.reporter is string && d.reporter.size() <= 80
        && d.description is string && d.description.size() > 0 && d.description.size() <= 800
        && d.openedAt is string && d.openedAt.size() == 10
        && d.status in ['open', 'doing', 'closed']
        && (!d.keys().hasAny(['department']) || d.department == null
            || d.department in ['logistics', 'it', 'maintenance', 'production', 'quality', 'process'])
        && optText(d, 'machine', 40) && optText(d, 'action', 800) && optText(d, 'owner', 80)
        && optDate(d, 'closedAt');
    }
    // Scheda aperta da dentro l'app, da un utente con accesso.
    function isValidAnomaly() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reporter', 'machine', 'openedAt', 'description', 'action',
          'owner', 'department', 'closedAt', 'status', 'source', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.createdAt == request.time
        && anomalyFieldsOk(d);
    }
    // Scheda aperta dal QR, senza accesso.
    function isQrReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reporter', 'machine', 'openedAt', 'description', 'action',
          'owner', 'department', 'closedAt', 'status', 'source', 'createdAt'])
        && d.source == 'qr'
        && d.createdAt == request.time
        && d.reporter.size() > 0
        && anomalyFieldsOk(d);
    }

    match /auditLog/{id} {
      // Ogni utente autenticato puo' registrare un proprio evento (login/modifica);
      // il registro si legge/elimina solo con ruolo configAdmin.
      // la riga deve portare l'uid di chi la scrive: nessuno puo' registrare
      // un'azione a nome di un altro utente
      allow create: if isSignedIn()
        && request.resource.data.username is string
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isSignedIn() && myRole() == 'configAdmin';
      allow update: if false;
    }
  }
}
